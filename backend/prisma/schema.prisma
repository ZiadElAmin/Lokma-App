
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  phone          String?
  role           Role     @default(Customer)
  roleChosen     Boolean  @default(true)
  isAvailable    Boolean  @default(true)
  pushToken      String?
  avatar         String?
  bio            String?
  cookLat        Float?
  cookLng        Float?
  cookAddress    String?
  violationCount Int      @default(0)
  isDisabled     Boolean  @default(false)
  meals          Meal[]   @relation("CookMeals")
  orders         Order[]
  deliveries     Order[]  @relation("RiderDeliveries")
  reviews        Review[]
  addresses      Address[]
  violations     Violation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Meal {
  id          String       @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  category    String       @default("Other")
  estimatedTime Int?       // estimated cook time in minutes
  cook        User         @relation("CookMeals", fields: [cookId], references: [id])
  cookId      String
  reviews     Review[]
  rating      Float        @default(0)
  numReviews  Int          @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Order {
  id                 String      @id @default(cuid())
  user               User        @relation(fields: [userId], references: [id])
  userId             String
  orderItems         OrderItem[]
  shippingAddress    String
  paymentMethod      String
  paymentResult      String?
  taxPrice           Float       @default(0.0)
  shippingPrice      Float       @default(0.0)
  totalPrice         Float       @default(0.0)
  isPaid             Boolean     @default(false)
  paidAt             DateTime?
  isDelivered        Boolean     @default(false)
  deliveredAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  isAccepted         Boolean     @default(false)
  acceptedAt         DateTime?
  estimatedMinutes   Int?        // cook's estimated prep time, snapshotted at accept
  isRejected         Boolean     @default(false)
  aiVerified         Boolean     @default(false)
  isReadyForPickup   Boolean     @default(false)
  readyAt            DateTime?
  rider              User?       @relation("RiderDeliveries", fields: [riderId], references: [id])
  riderId            String?
  isPickedUp         Boolean     @default(false)
  pickedUpAt         DateTime?
  isCancelled        Boolean     @default(false)
  deliveryLat        Float?
  deliveryLng        Float?
  // PPE compliance tracking (10-min photo re-checks while actively cooking)
  complianceDueAt        DateTime?
  complianceReminderSent Boolean   @default(false)
  complianceLastCheck    DateTime?
  envSafe                Boolean?
  envRecommendations     String?
  reviews            Review[]
}

model Violation {
  id        String   @id @default(cuid())
  cook      User     @relation(fields: [cookId], references: [id])
  cookId    String
  orderId   String?
  reason    String
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId    String
  name      String
  qty       Int
  image     String
  price     Float
  note      String?
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Float
  comment   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  meal      Meal     @relation(fields: [mealId], references: [id])
  mealId    String
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per meal per order (old reviews have null orderId and are unaffected).
  @@unique([userId, mealId, orderId])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String   @default("Home")
  lat       Float
  lng       Float
  building  String
  floor     String?
  apartment String?
  notes     String?
  createdAt DateTime @default(now())
}

enum Role {
  Customer
  Cook
  Rider
  Admin
}
